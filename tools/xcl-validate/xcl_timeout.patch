+/// Fence timeout for the comparison harness; the default 10 s is too short for the
+/// loop-guard-bounded shaders in the s4-r4 timeout study (XCL_CMP_GPU_TIMEOUT_MS).
+fn gpu_timeout_ms() -> u32 {
+    std::env::var("XCL_CMP_GPU_TIMEOUT_MS").ok().and_then(|v| v.parse().ok()).unwrap_or(10_000)
+}
